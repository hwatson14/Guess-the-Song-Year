{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwatson14.github.io/Guess-the-Song-Year/data/catalogue.schema.json",
  "title": "Guess the Song Year prebuilt catalogue",
  "description": "Contract for the static catalogue used by the game. Greatest Hits is the only active mode in v7. Song year must equal the year bucket used by the card map.",
  "type": "object",
  "required": ["version", "modes"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "generatedAt": {"type": "string"},
    "modes": {
      "type": "object",
      "required": ["greatest"],
      "properties": {
        "greatest": {
          "type": "object",
          "patternProperties": {
            "^(19[5-9][0-9]|20[0-2][0-9])$": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/song"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "song": {
      "type": "object",
      "required": ["title", "artist", "year"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "artist": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1950, "maximum": 2022, "description": "Canonical game/release year. This must match the containing year bucket."},
        "spotifyId": {"type": "string"},
        "youtubeId": {"type": "string"},
        "source": {"type": "string"},
        "sourceLabel": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
